#!/system/bin/sh
# Copyright (C) 2026 AERA Recovery Project contributors
# SPDX-License-Identifier: Apache-2.0

# This is stupid
set -u

PATH=/system/bin:/sbin
export PATH

readonly stock_root=/mnt/aera-stock
readonly vendor_root="${stock_root}/vendor"
readonly system_root="${stock_root}/system"
readonly odm_root="${stock_root}/odm"
readonly vendor_dlkm_mnt="${stock_root}/vendor_dlkm"

readonly stable_vendor=/system/aera-audio-vendor
readonly stable_system_lib64=/system/aera-audio-system-lib64
readonly audio_config_stage=/tmp/aera-audio-config

readonly lock_dir="${stock_root}/.audio-lock"
readonly lock_attempts=300

readonly audio_modules="\
    q6_notifier_dlkm q6_dlkm q6_pdr_dlkm spf_core_dlkm gpr_dlkm \
    audpkt_ion_dlkm audio_pkt_dlkm audio_prm_dlkm snd_event_dlkm \
    pinctrl_lpi_dlkm swr_dlkm swr_ctrl_dlkm swr_dmic_dlkm swr_haptics_dlkm \
    stub_dlkm lpass_cdc_dlkm \
    lpass_cdc_va_macro_dlkm lpass_cdc_rx_macro_dlkm lpass_cdc_tx_macro_dlkm \
    lpass_cdc_wsa_macro_dlkm lpass_cdc_wsa2_macro_dlkm \
    wcd9xxx_dlkm wcd_core_dlkm mbhc_dlkm \
    wcd938x_dlkm wcd938x_slave_dlkm wcd937x_dlkm wcd937x_slave_dlkm \
    wsa881x_dlkm wsa883x_dlkm hdmi_dlkm \
    machine_dlkm"

readonly optional_modules="wsa881x_dlkm"

module_dirs="/lib/modules ${vendor_dlkm_mnt}/lib/modules ${vendor_root}/lib/modules"

slot_suffix="$(getprop ro.boot.slot_suffix)"
audio_stage=bootstrap-start
audio_module_list=""

log_message() {
    priority="$1"
    shift
    /system/bin/log -t AERA-Audio -p "${priority}" "$*" 2>/dev/null || true
    echo "AERA-Audio: $*" >&2
    echo "AERA-Audio: $*" > /dev/kmsg 2>/dev/null || true
}

set_stage() {
    audio_stage="$1"
    log_message i "stage=${audio_stage}"
}

fail() {
    log_message e "FAILED stage=${audio_stage}: $*"
    exit 1
}

prog_running() {
    ps -A 2>/dev/null | grep -F "$1" | grep -v grep >/dev/null 2>&1
}

is_mounted() {
    grep -q " $1 " /proc/mounts 2>/dev/null
}

find_partition() {
    for candidate in \
        "/dev/block/mapper/$1${slot_suffix}" \
        "/dev/block/mapper/$1_a" \
        "/dev/block/mapper/$1_b" \
        "/dev/block/bootdevice/by-name/$1${slot_suffix}" \
        "/dev/block/by-name/$1${slot_suffix}"; do
        [ -e "${candidate}" ] && { echo "${candidate}"; return 0; }
    done
    return 1
}

mount_read_only() {
    partition="$1"
    target="$2"
    is_mounted "${target}" && return 0
    source=""
    attempts=0
    while [ -z "${source}" ] && [ "${attempts}" -lt 100 ]; do
        source="$(find_partition "${partition}")"
        [ -n "${source}" ] && break
        attempts=$((attempts + 1))
        sleep 0.1
    done
    [ -n "${source}" ] || return 1
    mount -t erofs -o ro "${source}" "${target}" 2>/dev/null ||
        mount -t ext4 -o ro,noload "${source}" "${target}" 2>/dev/null
}

bind_read_only() {
    [ -e "$1" ] || fail "missing stock path $1"
    if ! is_mounted "$2"; then
        mount -o bind "$1" "$2" || fail "could not bind $1 on $2"
        mount -o remount,bind,ro "$2" 2>/dev/null
    fi
}

bind_file_read_only() {
    [ -f "$1" ] || fail "missing stock file $1"
    [ -e "$2" ] || touch "$2" || fail "could not create bind target $2"
    if ! is_mounted "$2"; then
        mount -o bind "$1" "$2" || fail "could not bind $1"
        mount -o remount,bind,ro "$2" 2>/dev/null
    fi
}

start_init_service() {
    service="$1"
    requirement="$2"
    audio_stage="start-${service}"

    if [ "$(getprop "init.svc.${service}")" = running ]; then
        log_message i "service=${service} already active"
        return 0
    fi

    setprop ctl.start "${service}"
    attempts=0
    while [ "$(getprop "init.svc.${service}")" != running ] &&
          [ "${attempts}" -lt 50 ]; do
        attempts=$((attempts + 1))
        sleep 0.1
    done
    if [ "$(getprop "init.svc.${service}")" = running ]; then
        log_message i "service=${service} running"
        return 0
    fi

    link_error="$(dmesg 2>/dev/null | grep -m1 -A1 "CANNOT LINK EXECUTABLE.*${service}")"
    [ -n "${link_error}" ] && log_message e "link failed: ${link_error}"

    if [ "${requirement}" = required ]; then
        fail "init service ${service} did not start"
    fi
    log_message w "service=${service} skipped, optional"
    return 0
}

find_module_file() {
    for dir in ${module_dirs}; do
        [ -f "${dir}/$1.ko" ] && { echo "${dir}/$1.ko"; return 0; }
    done
    return 1
}

find_modules_dep() {
    for dir in ${module_dirs}; do
        [ -f "${dir}/modules.dep" ] && { echo "${dir}/modules.dep"; return 0; }
    done
    return 1
}

is_loaded() {
    grep -q "^$1 " /proc/modules 2>/dev/null && return 0
    grep -q "^$(echo "$1" | tr '-' '_') " /proc/modules 2>/dev/null
}

insert_module() {
    module_file="$1"
    insmod "${module_file}" 2>/tmp/aera-insmod.log && return 0
    insmod -f "${module_file}" 2>>/tmp/aera-insmod.log && return 0
    return 1
}

find_symbol_providers() {
    for dir in ${module_dirs}; do
        [ -d "${dir}" ] || continue
        for candidate in "${dir}"/*.ko; do
            [ -f "${candidate}" ] || continue
            stem="$(basename "${candidate}" .ko)"
            base="$(echo "${stem}" | sed 's/_dlkm$//')"
            case "$1" in
                "${base}"_*) echo "${candidate}" ;;
            esac
        done
    done | sort -u
}

load_symbol_providers() {
    symbols="$(dmesg 2>/dev/null |
        sed -n 's/.*Unknown symbol \([A-Za-z0-9_]*\).*/\1/p' | sort -u)"
    [ -n "${symbols}" ] || return 1

    loaded_any=0
    for symbol in ${symbols}; do
        for provider in $(find_symbol_providers "${symbol}"); do
            provider_name="$(basename "${provider}" .ko)"
            is_loaded "${provider_name}" && continue
            if insert_module "${provider}"; then
                log_message i "module=${provider_name} loaded from ${provider}, symbol=${symbol}"
                loaded_any=1
            fi
        done
    done
    [ "${loaded_any}" -eq 1 ]
}

expand_dependency_closure() {
    dep_file="$1"
    [ -n "${dep_file}" ] || return 0

    round=0
    while [ "${round}" -lt 12 ]; do
        round=$((round + 1))
        changed=0
        for name in ${audio_module_list}; do
            line="$(grep -m1 -E "(^|/)${name}\.ko:" "${dep_file}" 2>/dev/null)"
            deps="$(echo "${line}" |
                sed -e 's/^[^:]*: *//' -e 's#/[^ ]*/##g' -e 's/\.ko//g')"
            for dependency in ${deps}; do
                case " ${audio_module_list} " in
                    *" ${dependency} "*) ;;
                    *)
                        audio_module_list="${dependency} ${audio_module_list}"
                        changed=1
                        ;;
                esac
            done
        done
        [ "${changed}" -eq 0 ] && break
    done
}

run_load_passes() {
    pass=0
    while [ "${pass}" -lt 6 ]; do
        pass=$((pass + 1))
        progress=0
        for name in ${audio_module_list}; do
            is_loaded "${name}" && continue
            path="$(find_module_file "${name}")" || continue
            if insert_module "${path}"; then
                progress=1
                log_message i "module=${name} loaded from ${path}"
            fi
        done
        [ "${progress}" -eq 0 ] && break
    done
}

discover_modules_from_load_file() {
    for dir in ${module_dirs}; do
        [ -f "${dir}/modules.load" ] || continue
        discovered="$(grep -E \
            '^(q6_|spf_core|gpr_|audpkt_ion|audio_pkt|audio_prm|adsp_loader|pinctrl_lpi|swr|snd_event|wcd|mbhc|stub_|lpass_cdc|wsa883x|hdmi_|aw882xx|machine_)' \
            "${dir}/modules.load" | sed 's/\.ko$//' | tr '\n' ' ')"
        if [ -n "${discovered}" ]; then
            log_message w "machine_dlkm not found, using modules.load list"
            audio_module_list="${discovered}"
            return 0
        fi
    done
    return 1
}

report_module_failures() {
    for name in ${audio_module_list}; do
        is_loaded "${name}" && continue
        path="$(find_module_file "${name}" 2>/dev/null)"
        if [ -z "${path}" ]; then
            case " ${optional_modules} " in
                *" ${name} "*)
                    log_message i "module=${name} not in this ROM, optional"
                    continue
                    ;;
            esac
            log_message e "module=${name} missing, no ${name}.ko in ${module_dirs}"
            continue
        fi
        vermagic="$(tr -c '[:print:]' '\n' < "${path}" 2>/dev/null |
            grep -m1 '^vermagic=' | sed 's/^vermagic=//')"
        log_message e "module=${name} not loaded, vermagic=${vermagic:-unknown}"
    done
}

report_kernel_module_errors() {
    if dmesg 2>/dev/null | grep -q "Unknown symbol"; then
        dmesg 2>/dev/null |
            sed -n 's/.*Unknown symbol \([A-Za-z0-9_]*\).*/kernel: unknown symbol \1/p' |
            sort -u |
            while read -r line; do log_message e "${line}"; done
    fi
    [ -s /tmp/aera-insmod.log ] || return 0

    log_message e "insmod: $(tail -n 1 /tmp/aera-insmod.log 2>/dev/null)"
    if grep -q "Invalid module format" /tmp/aera-insmod.log 2>/dev/null; then
        log_message e "modules built for another kernel, running $(uname -r)"
        log_message e "flash a recovery matching the installed ROM"
    fi
}

step_skip_if_already_running() {
    if [ "$(getprop init.svc.agm-service)" = running ]; then
        log_message i "backend already active, leaving it alone"
        exit 0
    fi
}

step_prepare_layout() {
    set_stage prepare-layout
    mkdir -p "${stock_root}" "${vendor_root}" "${system_root}" "${odm_root}" \
        "${vendor_dlkm_mnt}" /firmware /vendor/firmware \
        /vendor/firmware_mnt /vendor/dsp /vendor/lib/rfsa/adsp \
        /vendor/etc/acdbdata /vendor/etc/audio \
        "${stable_vendor}" "${stable_system_lib64}" /vendor/etc/seccomp_policy
}

step_take_lock() {
    attempts=0
    while ! mkdir "${lock_dir}" 2>/dev/null; do
        step_skip_if_already_running
        attempts=$((attempts + 1))
        [ "${attempts}" -ge "${lock_attempts}" ] && fail "another bootstrap did not finish"
        sleep 0.1
    done
    trap 'rmdir "${lock_dir}" 2>/dev/null' EXIT
}

step_mount_images() {
    set_stage mount-stock-images
    mount_read_only vendor "${vendor_root}" || fail "could not mount stock vendor"
    mount_read_only system "${system_root}" ||
        log_message w "stock system not mounted, using recovery libs"
    mount_read_only odm "${odm_root}" ||
        log_message w "stock odm not mounted"
    mount_read_only vendor_dlkm "${vendor_dlkm_mnt}" ||
        log_message w "vendor_dlkm not mounted, using ramdisk modules"
}

step_mount_dsp() {
    set_stage mount-dsp
    if ! is_mounted /vendor/dsp; then
        dsp="/dev/block/bootdevice/by-name/dsp${slot_suffix}"
        [ -e "${dsp}" ] || dsp="/dev/block/by-name/dsp${slot_suffix}"
        [ -e "${dsp}" ] || fail "the active DSP partition is missing"
        mount -t ext4 -o ro,noload "${dsp}" /vendor/dsp ||
            fail "could not mount the DSP module partition"
    fi
    [ -e /dsp ] || ln -s /vendor/dsp /dsp || fail "could not expose the /dsp alias"
}

step_expose_runtime() {
    set_stage expose-stock-runtime
    system_lib64="${system_root}/system/lib64"
    [ -f "${system_lib64}/libbinder.so" ] || system_lib64="${system_root}/lib64"

    bind_read_only "${vendor_root}" "${stable_vendor}"
    if [ -d "${system_lib64}" ]; then
        bind_read_only "${system_lib64}" "${stable_system_lib64}"
    else
        log_message w "no stock framework libs, using recovery libs"
    fi
}

step_expose_firmware() {
    set_stage expose-firmware
    if ! is_mounted /firmware; then
        modem="/dev/block/bootdevice/by-name/modem${slot_suffix}"
        [ -e "${modem}" ] || modem="/dev/block/by-name/modem${slot_suffix}"
        [ -e "${modem}" ] || fail "the active modem firmware partition is missing"
        mount -t vfat -o ro "${modem}" /firmware ||
            fail "could not mount the ADSP firmware partition"
    fi
    is_mounted /vendor/firmware_mnt ||
        mount -o bind /firmware /vendor/firmware_mnt ||
        fail "could not expose ADSP firmware to the vendor tree"
}

step_expose_audio_config() {
    set_stage expose-audio-config

    rm -rf "${audio_config_stage}"
    mkdir -p "${audio_config_stage}"
    cp -a "${vendor_root}/etc/audio/." "${audio_config_stage}/" ||
        fail "could not stage the stock audio configuration"

    sku_dir="${audio_config_stage}/sku_ukee"
    if [ -d "${sku_dir}" ]; then
        for sku in ukee marble taro; do
            mkdir -p "${audio_config_stage}/sku_${sku}"
            if [ "${sku}" != ukee ]; then
                cp -a "${sku_dir}/." "${audio_config_stage}/sku_${sku}/" 2>/dev/null
            fi
            for target in mtp atp cdp cdp-qhd qrd idp; do
                for base in mixer_paths resourcemanager; do
                    if [ -f "${sku_dir}/${base}_ukee_mtp.xml" ]; then
                        cp "${sku_dir}/${base}_ukee_mtp.xml" \
                            "${audio_config_stage}/sku_${sku}/${base}_${sku}_${target}.xml"
                    fi
                done
            done
        done
        log_message i "audio tables staged for ukee marble taro"
    else
        log_message w "no sku_ukee audio tables"
    fi

    is_mounted /vendor/etc/audio ||
        mount -o bind "${audio_config_stage}" /vendor/etc/audio ||
        fail "could not expose the stock audio configuration"

    if [ -f "${vendor_root}/etc/backend_conf.xml" ]; then
        bind_file_read_only "${vendor_root}/etc/backend_conf.xml" /vendor/etc/backend_conf.xml
    else
        log_message w "no backend_conf.xml, smart-PA routing unknown"
    fi
    bind_file_read_only "${vendor_root}/etc/card-defs.xml" /vendor/etc/card-defs.xml
    bind_file_read_only "${vendor_root}/etc/usecaseKvManager.xml" \
        /vendor/etc/usecaseKvManager.xml
    [ -d "${vendor_root}/etc/acdbdata" ] &&
        bind_read_only "${vendor_root}/etc/acdbdata" /vendor/etc/acdbdata
    bind_file_read_only \
        "${vendor_root}/etc/seccomp_policy/vendor.qti.hardware.dsp.policy" \
        /vendor/etc/seccomp_policy/vendor.qti.hardware.dsp.policy

    rfsa_source="${odm_root}/lib/rfsa/adsp"
    [ -d "${rfsa_source}" ] || rfsa_source="${vendor_root}/lib/rfsa/adsp"
    if [ -d "${rfsa_source}" ]; then
        bind_read_only "${rfsa_source}" /vendor/lib/rfsa/adsp
    else
        log_message w "no rfsa/adsp modules"
    fi

    mkdir -p /data/vendor/audio/acdbdata/delta /data/vendor/audio_dsp
    chmod 0777 /data/vendor/audio 2>/dev/null
    chown audio audio /data/vendor/audio 2>/dev/null
}

step_stage_amp_firmware() {
    set_stage stage-amp-firmware
    staged=0
    for name in aw882xx_acf.bin aw_cali.bin aw882xx_cali.bin; do
        [ -e "/vendor/firmware/${name}" ] && continue
        for dir in "${odm_root}/firmware" "${vendor_root}/firmware" \
                   "${vendor_root}/etc/firmware" "${odm_root}/etc/firmware"; do
            if [ -f "${dir}/${name}" ]; then
                cp "${dir}/${name}" "/vendor/firmware/${name}" 2>/dev/null &&
                    staged=$((staged + 1))
                break
            fi
        done
    done
    log_message i "amp firmware: ${staged} files in /vendor/firmware"
}

step_load_modules() {
    set_stage load-audio-modules
    audio_module_list="${audio_modules}"
    dep_file="$(find_modules_dep)"

    find_module_file machine_dlkm >/dev/null || discover_modules_from_load_file

    log_message i "kernel=$(uname -r) depfile=${dep_file:-none}"
    expand_dependency_closure "${dep_file}"
    run_load_passes

    if ! is_loaded machine_dlkm; then
        if load_symbol_providers; then
            log_message i "retrying module load"
            run_load_passes
        fi
    fi

    report_module_failures
    report_kernel_module_errors
}

step_stage_pd_maps() {
    set_stage stage-pd-maps

    source_dir=""
    for candidate in /firmware/image /vendor/firmware_mnt/image \
                     "${vendor_root}/firmware/image"; do
        for map in "${candidate}"/*.jsn; do
            [ -e "${map}" ] && { source_dir="${candidate}"; break; }
        done
        [ -n "${source_dir}" ] && break
    done
    if [ -z "${source_dir}" ]; then
        log_message w "no .jsn maps in /firmware/image"
        return 1
    fi

    stage=/tmp/aera-pd-maps
    rm -rf "${stage}"
    mkdir -p "${stage}" || return 1

    maps=0
    for map in "${source_dir}"/*.jsn; do
        [ -e "${map}" ] || continue
        cp "${map}" "${stage}/" 2>/dev/null || continue
        chmod 0644 "${stage}/$(basename "${map}")" 2>/dev/null
        maps=$((maps + 1))
    done
    if [ "${maps}" -eq 0 ]; then
        log_message w "cannot stage maps from ${source_dir}"
        return 1
    fi

    mkdir -p /vendor/firmware 2>/dev/null
    for map in "${stage}"/*.jsn; do
        cp -f "${map}" /vendor/firmware/ 2>/dev/null
    done
    if [ ! -e /vendor/firmware/adspua.jsn ]; then
        is_mounted /vendor/firmware ||
            mount -o bind "${stage}" /vendor/firmware 2>/dev/null ||
            log_message w "cannot bind ${stage} on /vendor/firmware"
    fi

    log_message i "maps=${maps} from ${source_dir}"
    [ -e /vendor/firmware/adspua.jsn ] ||
        log_message w "adspua.jsn missing"
    return 0
}

restart_adsp() {
    audio_stage=restart-adsp
    log_message i "stage=${audio_stage}"

    adsp=""
    for candidate in /sys/class/remoteproc/remoteproc*; do
        [ -r "${candidate}/name" ] || continue
        case "$(cat "${candidate}/name")" in
            *remoteproc-adsp) adsp="${candidate}"; break ;;
        esac
    done
    [ -n "${adsp}" ] || fail "could not find the ADSP remoteproc"
    log_message i "ADSP state=$(cat "${adsp}/state" 2>/dev/null) path=${adsp}"

    if [ "$(cat "${adsp}/state" 2>/dev/null)" = running ]; then
        [ -w /sys/kernel/boot_adsp/ssr ] ||
            fail "the ADSP restart control is unavailable"
        echo 1 > /sys/kernel/boot_adsp/ssr || fail "could not restart the ADSP"
        sleep 1
    else
        echo start > "${adsp}/state" || fail "could not boot the ADSP"
    fi

    attempts=0
    while [ "$(cat "${adsp}/state" 2>/dev/null)" != running ] &&
          [ "${attempts}" -lt 150 ]; do
        attempts=$((attempts + 1))
        sleep 0.1
    done
    [ "$(cat "${adsp}/state" 2>/dev/null)" = running ] ||
        fail "the ADSP did not enter the running state"
    log_message i "ADSP running, fw=$(cat "${adsp}/firmware" 2>/dev/null)"
}

step_start_dsp_services() {
    step_stage_pd_maps || log_message w "pd-mapper has no maps"

    start_init_service audioadsprpcd required
    start_init_service pd-mapper required
    start_init_service dspservice optional

    restart_adsp
}

step_reload_amp() {
    is_loaded aw882xx_dlkm || return 0
    amp_module="$(find_module_file aw882xx_dlkm)" || return 0

    rmmod aw882xx_dlkm 2>/dev/null
    if insmod "${amp_module}" 2>/tmp/aera-amp-insmod.log; then
        log_message i "aw882xx_dlkm reloaded"
    else
        log_message w "aw882xx_dlkm reload failed: $(tr '\n' ' ' < /tmp/aera-amp-insmod.log)"
    fi
}

wait_for_card() {
    attempts=0
    while [ ! -e /dev/snd/controlC0 ] && [ "${attempts}" -lt 250 ]; do
        attempts=$((attempts + 1))
        sleep 0.1
    done
    [ -e /dev/snd/controlC0 ]
}

step_wait_for_card() {
    set_stage wait-machine-card
    if ! wait_for_card; then
        log_message w "no card after ADSP restart, retrying"
        restart_adsp
        wait_for_card
    fi

    if [ ! -e /dev/snd/controlC0 ]; then
        log_message e "cards: $(tr '\n' ' ' < /proc/asound/cards 2>/dev/null)"
        if [ -r /sys/kernel/debug/devices_deferred ]; then
            while IFS= read -r deferred; do
                [ -n "${deferred}" ] && log_message e "deferred=${deferred}"
            done < /sys/kernel/debug/devices_deferred
        fi
        fail "the Qualcomm machine sound card did not register"
    fi

    log_message i "card up"
    chown media audio /sys/kernel/snd_card/card_state 2>/dev/null
}

start_agm_fallback() {
    fallback=/vendor/bin/hw/aera-agm-service
    if [ -x "${fallback}" ]; then
        log_message w "agm-ipc down, starting ${fallback}"
        (
            LD_LIBRARY_PATH=/vendor/aera-audio:/system/aera-audio-vendor/lib64/hw:/system/aera-audio-vendor/lib64:/system/lib64
            export LD_LIBRARY_PATH
            exec /system/bin/linker64 "${fallback}"
        ) >/tmp/aera-agm-fallback.log 2>&1 &
        sleep 1
    fi

    if prog_running aera-agm-service; then
        log_message i "agm-ipc up, tree fallback"
        return 0
    fi
    log_message e "agm-ipc down, PAL clients will fail"
    [ -s /tmp/aera-agm-fallback.log ] &&
        log_message e "agm fallback: $(tr '\n' ' ' < /tmp/aera-agm-fallback.log)"
    return 1
}

step_start_agm() {
    set_stage start-agm

    start_init_service agm-ipc optional
    sleep 0.5
    if [ "$(getprop init.svc.agm-ipc)" = running ] ||
       prog_running AGMIPC@1.0-service; then
        log_message i "agm-ipc up, init service"
    else
        start_agm_fallback
    fi

    start_init_service aera-agm-service optional
    setprop sys.aera.audio.ready 1
}

main() {
    step_validate_device
    step_skip_if_already_running
    step_prepare_layout
    step_take_lock

    step_mount_images
    step_mount_dsp
    step_expose_runtime
    step_expose_firmware
    step_expose_audio_config
    step_stage_amp_firmware

    step_load_modules
    step_start_dsp_services
    step_reload_amp
    step_wait_for_card
    step_start_agm

    set_stage complete
    log_message i "backend ready"
}

main "$@"
