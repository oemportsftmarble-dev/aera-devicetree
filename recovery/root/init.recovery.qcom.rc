import /init.recovery.wifi.rc

on early-init
    wait /sys/fs/selinux/enforce
    write /sys/fs/selinux/enforce 0
    setprop vendor.gatekeeper.disable_spu true

service aera-graphics-allocator /vendor/bin/hw/vendor.qti.hardware.display.allocator-service
    class hal
    seclabel u:r:recovery:s0
    user root
    group root graphics
    capabilities SYS_NICE
    oneshot

on init
    start boot-hal-1-2

on fs
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0660 /dev/smcinvoke
    chown system drmrpc /dev/smcinvoke
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    mkdir /tmp/persist 0775 shell system
    mount none /tmp/persist /mnt/vendor/persist bind rec

on boot
    setprop sys.usb.config adb
    start fl_service

on property:twrp.modules.loaded=true
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery
    start vendor.qseecomd
    start health-hal-2-1
    start vibratorfeature-hal-service
    umount /firmware
    start audio-service

on property:post.decrypt.modules=true
    start audio-service

on property:vendor.sys.listeners.registered=true
    start vendor.gatekeeper_default
    start vendor.keymaster-qti
    start keymint-qti

service fl_service /system/bin/aera_flashlight.sh
    class core
    user root
    group root
    seclabel u:r:recovery:s0

service pd-mapper /system/bin/linker64 /system/aera-audio-vendor/bin/pd-mapper
    class core
    disabled
    user root
    group root system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64:/system/lib64

service audioadsprpcd /system/bin/linker64 /system/aera-audio-vendor/bin/audioadsprpcd audiopd
    class main
    disabled
    user media
    group media
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64:/system/lib64

service dspservice /system/bin/linker64 /system/aera-audio-vendor/bin/dspservice
    class hal
    disabled
    user system
    group system wakelock oem_2908
    capabilities BLOCK_SUSPEND
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64:/system/lib64
    interface vendor.qti.hardware.dsp@1.0::IDspService dspservice

service agm-ipc /system/bin/linker64 /system/aera-audio-vendor/bin/hw/vendor.qti.hardware.AGMIPC@1.0-service
    class hal
    disabled
    user system
    group system audio media mediadrm oem_2901 wakelock
    capabilities BLOCK_SUSPEND SYS_NICE
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64/hw:/system/aera-audio-vendor/lib64:/vendor/aera-audio:/system/lib64

service agm-service /system/bin/aera-audio-hal
    class main
    disabled
    user root
    group root system audio media wakelock
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64/hw:/system/aera-audio-vendor/lib64:/vendor/aera-audio:/system/lib64
    setenv ANDROID_ROOT /system
    setenv ANDROID_DATA /data

service audio-service /system/bin/aera-audio-service
    class core
    disabled
    oneshot
    user root
    group root system audio media wakelock
    seclabel u:r:recovery:s0
